<Window x:Class="HenshinGrid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HENSHIN // GRID" Width="1400" Height="850" MinWidth="1120" MinHeight="690"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" WindowStyle="None" ResizeMode="CanResize"
        Background="#000000" FontFamily="Segoe UI" Foreground="#EAFBFF">
  <Window.Resources>
    <Style x:Key="GameTile" TargetType="Border">
      <Setter Property="Background" Value="#E0112234"/>
      <Setter Property="BorderBrush" Value="#5952C7CF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Margin" Value="0,0,16,16"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#E3163A4B"/>
          <Setter Property="BorderBrush" Value="#FF3AFFF1"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource HudButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <DrawingBrush x:Key="GridPattern" Viewport="0,0,44,44" ViewportUnits="Absolute" TileMode="Tile" Stretch="None" Opacity="0.13">
      <DrawingBrush.Drawing>
        <GeometryDrawing Brush="Transparent">
          <GeometryDrawing.Pen><Pen Brush="#5BE5EE" Thickness="0.65"/></GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <LineGeometry StartPoint="0,0" EndPoint="44,0"/>
              <LineGeometry StartPoint="0,0" EndPoint="0,44"/>
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </Window.Resources>
  <Grid>
    <Grid.Triggers>
      <EventTrigger RoutedEvent="FrameworkElement.Loaded">
        <BeginStoryboard>
          <Storyboard RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="HudRotation"
                             Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:1:30"/>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Grid.Triggers>
    <!-- Dynamic wallpaper content remains behind the application's HUD. -->
    <Image x:Name="WallpaperImage" Stretch="UniformToFill"/>
    <MediaElement x:Name="WallpaperVideo" Stretch="UniformToFill" LoadedBehavior="Manual" UnloadedBehavior="Stop" IsMuted="True"
                  MediaEnded="WallpaperVideo_MediaEnded" MediaFailed="WallpaperVideo_MediaFailed"/>
    <!-- True OLED black: the default canvas and the dim layer are #000000, without a gray/blue tint. -->
    <Rectangle x:Name="WallpaperShade" Fill="#000000" Opacity="0.36" IsHitTestVisible="False"/>
    <Rectangle x:Name="DataGridOverlay" Fill="{StaticResource GridPattern}" IsHitTestVisible="False"/>
    <Canvas x:Name="HologramCanvas" Width="490" Height="490" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,92,48,0" Opacity="0.38" IsHitTestVisible="False">
      <Canvas.RenderTransform><RotateTransform x:Name="HudRotation" CenterX="245" CenterY="245"/></Canvas.RenderTransform>
      <Ellipse Canvas.Left="26" Canvas.Top="26" Width="438" Height="438" Stroke="{DynamicResource NeonCyan}" StrokeThickness="1.3" StrokeDashArray="4,10"/>
      <Ellipse Canvas.Left="63" Canvas.Top="63" Width="364" Height="364" Stroke="#F63F5C" StrokeThickness="2" StrokeDashArray="28,17"/>
      <Ellipse Canvas.Left="106" Canvas.Top="106" Width="278" Height="278" Stroke="{DynamicResource NeonCyan}" StrokeThickness="5" StrokeDashArray="1,14"/>
      <Ellipse Canvas.Left="149" Canvas.Top="149" Width="192" Height="192" Stroke="{DynamicResource NeonCyan}" StrokeThickness="0.8"/>
      <Path Data="M245,0 L245,65 M245,425 L245,490 M0,245 L65,245 M425,245 L490,245" Stroke="#F54267" StrokeThickness="1"/>
    </Canvas>
    <Grid Margin="32,19,32,19">
      <Grid.RowDefinitions>
        <RowDefinition Height="94"/>
        <RowDefinition Height="72"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="34"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" MouseLeftButtonDown="DragRegion_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Width="72" Height="72">
          <Ellipse Stroke="#42EAE8" StrokeThickness="3" StrokeDashArray="9,4"/>
          <Ellipse Margin="8" Stroke="#FA3D62" StrokeThickness="1.4"/>
          <Path Stroke="#9BFFF9" Fill="Transparent" StrokeThickness="2.2" Data="M13,36 L27,16 L35,30 L46,15 L60,36 L47,55 L36,41 L25,55 Z"/>
          <TextBlock Text="H" FontFamily="Consolas" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#EAFFFF"/>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="HENSHIN // GRID" FontFamily="Consolas" FontSize="31" FontWeight="Bold" Foreground="#EAFDFF"/>
          <StackPanel Orientation="Horizontal" Margin="2,5,0,0">
            <TextBlock Text="PERSONAL GAME TERMINAL" FontSize="10" Foreground="{DynamicResource NeonCyan}" FontFamily="Consolas"/>
            <TextBlock Text="    /    HOLOGRAPHIC LIBRARY SYSTEM    /    v0.1" FontSize="10" Foreground="#85A3AE" FontFamily="Consolas"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Style="{StaticResource HudButton}" Content="—" Width="42" Click="Minimize_Click" Margin="0,0,6,0"/>
          <Button Style="{StaticResource HudButton}" Content="▢" Width="42" Click="Maximize_Click" Margin="0,0,6,0"/>
          <Button Style="{StaticResource HudButton}" Content="✕" Width="42" Click="Close_Click" BorderBrush="#BDFF5672"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,8,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border BorderBrush="#4BFF5C77" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
        <TextBlock Text="◆  SYSTEM / GAME ARCHIVE" FontSize="13" FontFamily="Consolas" Foreground="#FD6580" VerticalAlignment="Center"/>
        <Border Grid.Column="1" BorderBrush="#4F55D1D5" BorderThickness="1" Background="#E608080D" Height="42" Margin="14,0,10,0">
          <DockPanel>
            <TextBlock Text="⌕" FontSize="23" Foreground="#52ECED" Margin="14,4,12,0" DockPanel.Dock="Left"/>
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="Transparent" BorderThickness="0" Foreground="White"
                     FontSize="15" CaretBrush="#4BFFF4" VerticalContentAlignment="Center" ToolTip="Tìm theo tên game, nền tảng"/>
          </DockPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="+ THÊM GAME" Style="{StaticResource HudButton}" Click="AddGame_Click" Margin="0,0,8,0"/>
          <Button Content="↻ QUÉT NGUỒN" Style="{StaticResource HudButton}" Click="Scan_Click"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="258"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#D9090910" BorderBrush="#6157D8DF" BorderThickness="1" Margin="0,0,18,0" Padding="16">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <TextBlock Text="// CONTROL DECK" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" Margin="0,0,0,19"/>
            <Button Content="◈  TẤT CẢ GAME" Style="{StaticResource SidebarButton}" Click="ShowAll_Click"/>
            <Button Content="◇  YÊU THÍCH" Style="{StaticResource SidebarButton}" Click="ShowFavorites_Click"/>
            <Border Height="1" Background="#4F64ADBD" Margin="0,13,0,22"/>
            <TextBlock Text="// WALLPAPER CORE" FontSize="12" FontFamily="Consolas" Foreground="#FF657E" FontWeight="Bold" Margin="0,0,0,15"/>
            <Button Content="▣  CHỌN ẢNH / VIDEO" Style="{StaticResource SidebarButton}" Click="SelectWallpaper_Click"/>
            <Button Content="◉  BẬT NỀN DESKTOP" Style="{StaticResource SidebarButton}" Click="EnableDesktop_Click"/>
            <Button Content="◯  TẮT NỀN DESKTOP" Style="{StaticResource SidebarButton}" Click="DisableDesktop_Click"/>
            <Button Content="×  NỀN ĐEN THUẦN" Style="{StaticResource SidebarButton}" Click="ClearWallpaper_Click"/>
            <CheckBox x:Name="OledCheck" Content="OLED BLACK  //  #000000" IsChecked="True" Foreground="#E4EDF0" FontSize="12"
                      Checked="OledCheck_Changed" Unchecked="OledCheck_Changed" Margin="4,8,0,10"/>
            <CheckBox x:Name="HologramCheck" Content="Hiển thị vòng HUD" IsChecked="True" Foreground="#C6DEEA" FontSize="12"
                      Checked="HologramCheck_Changed" Unchecked="HologramCheck_Changed" Margin="4,0,0,10"/>
            <TextBlock Text="ĐỘ TỐI NỀN" FontFamily="Consolas" Foreground="{DynamicResource NeonCyan}" FontSize="10" Margin="2,3,0,0"/>
            <Slider x:Name="DimSlider" Minimum="0" Maximum="100" Value="36" TickFrequency="5" Margin="3,8,4,12"
                    ValueChanged="DimSlider_ValueChanged" ToolTip="0 = ảnh/video rõ nhất • 100 = màn hình đen hoàn toàn"/>
            <TextBlock Text="ACCENT / HOLOGRAM" FontFamily="Consolas" Foreground="{DynamicResource NeonCyan}" FontSize="10" Margin="2,2,0,6"/>
            <ComboBox x:Name="AccentPicker" SelectionChanged="AccentPicker_SelectionChanged" Margin="0,0,0,11" Height="30" SelectedIndex="0">
              <ComboBoxItem Content="CYAN // #35F3E8" Tag="#35F3E8"/>
              <ComboBoxItem Content="RIDER RED // #FF345B" Tag="#FF345B"/>
              <ComboBoxItem Content="VIOLET // #B35BFF" Tag="#B35BFF"/>
              <ComboBoxItem Content="GOLD // #FFD45B" Tag="#FFD45B"/>
              <ComboBoxItem Content="EMERALD // #32FFAF" Tag="#32FFAF"/>
            </ComboBox>
            <Button Content="◈  MÀU HEX TÙY CHỈNH" Style="{StaticResource SidebarButton}" Click="CustomColor_Click"/>
            <CheckBox x:Name="MuteCheck" Content="Tắt tiếng wallpaper" IsChecked="True" Foreground="#C6DEEA" FontSize="12"
                      Checked="MuteCheck_Changed" Unchecked="MuteCheck_Changed" Margin="4,5,0,8"/>
            <CheckBox x:Name="PauseFullscreenCheck" Content="Tạm dừng khi fullscreen" IsChecked="True" Foreground="#C6DEEA" FontSize="12"
                      Checked="PauseFullscreenCheck_Changed" Unchecked="PauseFullscreenCheck_Changed" Margin="4,0,0,8"/>
            <Border Height="1" Background="#4F64ADBD" Margin="0,26,0,20"/>
            <TextBlock Text="// LIVE STATUS" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource NeonCyan}" FontWeight="Bold" Margin="0,0,0,9"/>
            <TextBlock x:Name="SidebarStatus" Text="LIBRARY READY" FontSize="11" FontFamily="Consolas" Foreground="#A7C7CE" TextWrapping="Wrap"/>
            <TextBlock Text="No injection  /  No game hooks" FontSize="10" FontFamily="Consolas" Foreground="#6C98A3" Margin="0,12,0,0" TextWrapping="Wrap"/>
          </StackPanel></ScrollViewer>
        </Border>
        <Grid Grid.Column="1">
          <Grid.RowDefinitions><RowDefinition Height="75"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Vertical">
              <TextBlock Text="GAME LIBRARY" FontSize="24" FontFamily="Consolas" FontWeight="Bold" Foreground="#FFFFFF"/>
              <TextBlock x:Name="CountText" Text="0 TITLES  //  READY TO LAUNCH" FontSize="11" Foreground="{DynamicResource NeonCyan}" FontFamily="Consolas" Margin="2,3,0,0"/>
            </StackPanel>
            <Border VerticalAlignment="Bottom" Height="1" Background="#8552E9EE"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="GameItems">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="182" Height="228" Style="{StaticResource GameTile}" Tag="{Binding}" MouseLeftButtonUp="GameTile_MouseLeftButtonUp"
                          ToolTip="Bấm vào để mở game">
                    <Grid Margin="10">
                      <Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition Height="*"/><RowDefinition Height="27"/></Grid.RowDefinitions>
                      <Border Grid.Row="0" BorderBrush="#4D73E3DB" BorderThickness="1" Background="#C00A1014">
                        <Grid>
                          <TextBlock Text="{Binding Monogram}" FontFamily="Consolas" FontSize="47" FontWeight="Bold" Foreground="#4DDAEAE8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Image Source="{Binding Icon}" Stretch="Uniform" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#BB0C2736" Padding="5,3">
                            <TextBlock Text="{Binding SourceLabel}" Foreground="#4BF4EB" FontFamily="Consolas" FontSize="9"/>
                          </Border>
                          <Path Data="M0,20 L0,0 L20,0 M138,0 L158,0 L158,20 M0,110 L0,130 L20,130 M138,130 L158,130 L158,110" Stroke="#A549EEE5" StrokeThickness="1" Stretch="None" IsHitTestVisible="False"/>
                        </Grid>
                      </Border>
                      <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="#F0FCFF" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                 TextWrapping="Wrap" MaxHeight="36" Margin="1,9,0,0" VerticalAlignment="Top"/>
                      <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Tag="{Binding}" Content="▶  PLAY" Click="GamePlay_Click" Style="{StaticResource HudButton}" Padding="9,2" FontSize="11"/>
                        <Button Grid.Column="1" Tag="{Binding}" Content="☆" Click="ToggleFavorite_Click" Style="{StaticResource HudButton}"
                                Padding="8,2" FontSize="14" Margin="5,0,0,0" ToolTip="Đánh dấu yêu thích"/>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
      <Grid Grid.Row="3" VerticalAlignment="Center">
        <TextBlock Text="HENSHIN GRID  //  LOCAL-FIRST  //  SAFE GAME LAUNCH" FontSize="10" Foreground="#78ABBA" FontFamily="Consolas"/>
        <TextBlock x:Name="FooterText" Text="READY  /  STANDBY" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource NeonCyan}" FontFamily="Consolas"/>
      </Grid>
    </Grid>
  </Grid>
</Window>